{
  "name": "artelier-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "test:ci": "ng test --watch=false",
    "default": "git switch main && git pull",
    "e2e": "npm run e2e:integration",
    "e2e:integration": "python3 e2e/run-integration.py",
    "e2e:ui": "node e2e/run-ui.mjs",
    "e2e:smoke": "python3 e2e/run-integration.py --project=chromium --grep=@smoke",
    "e2e:typecheck": "tsc -p e2e/tsconfig.json",
    "e2e:lint": "eslint e2e/**/*.ts playwright*.config.ts",
    "build:signature": "ng build --configuration production --browser e2e/signature-host.ts --ts-config e2e/tsconfig.signature.json --output-path dist/signature-e2e",
    "e2e:signature": "node e2e/run-signature.mjs",
    "api:setup": "npm ci --prefix tools/openapi",
    "api:generate": "node scripts/openapi.mjs",
    "api:check": "node scripts/openapi.mjs --check",
    "api:snapshot": "node scripts/openapi-snapshot.mjs"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "^26.6.6",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=11.0.0"
  }
}
